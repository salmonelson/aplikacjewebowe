@Cars.API_HostAddress = http://localhost:5080

GET {{Cars.API_HostAddress}}/api/cars
Accept: application/json

###

@carId = 11111111-1111-1111-1111-111111111111

GET {{Cars.API_HostAddress}}/api/cars/{{carId}}
Accept: application/json

###

