{
  "info": {
    "_postman_id": "8b8a5f2a-0c83-4c5a-9a20-1c7b3f6e4d11",
    "name": "Cars Web API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "carId",
      "value": "11111111-1111-1111-1111-111111111111"
    }
  ],
  "item": [
    {
      "name": "Get all cars",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cars"
      }
    },
    {
      "name": "Get car by id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cars/{{carId}}"
      }
    },
    {
      "name": "Create car",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"brand\": \"Honda\",\n  \"model\": \"Civic\",\n  \"doorsNumber\": 5,\n  \"luggageCapacity\": 420,\n  \"engineCapacity\": 1.5,\n  \"fuelType\": \"Petrol\",\n  \"productionDate\": \"2023-01-01T00:00:00Z\",\n  \"averageFuelConsumption\": 6.2,\n  \"bodyType\": \"Sedan\"\n}"
        },
        "url": "{{baseUrl}}/api/cars"
      }
    },
    {
      "name": "Update car",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"brand\": \"Toyota\",\n  \"model\": \"Corolla Updated\",\n  \"doorsNumber\": 5,\n  \"luggageCapacity\": 361,\n  \"engineCapacity\": 1.8,\n  \"fuelType\": \"Hybrid\",\n  \"productionDate\": \"2022-06-01T00:00:00Z\",\n  \"averageFuelConsumption\": 4.4,\n  \"bodyType\": \"Hatchback\"\n}"
        },
        "url": "{{baseUrl}}/api/cars/{{carId}}"
      }
    },
    {
      "name": "Delete car",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/cars/{{carId}}"
      }
    },
    {
      "name": "Create car - validation error",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"brand\": \"\",\n  \"model\": \"\",\n  \"doorsNumber\": 1,\n  \"luggageCapacity\": -10,\n  \"engineCapacity\": 0,\n  \"fuelType\": \"Petrol\",\n  \"productionDate\": \"2035-01-01T00:00:00Z\",\n  \"averageFuelConsumption\": -4.5,\n  \"bodyType\": \"Sedan\"\n}"
        },
        "url": "{{baseUrl}}/api/cars"
      }
    }
  ]
}
